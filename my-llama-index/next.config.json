{
  "experimental": {
    "outputFileTracingIncludes": {
      "/*": [
        "./cache/**/*"
      ]
    },
    "outputFileTracingExcludes": {
      "/api/files/*": [
        ".next/**/*",
        "node_modules/**/*",
        "public/**/*",
        "app/**/*"
      ]
    }
  },
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}